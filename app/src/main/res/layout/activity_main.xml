<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5" >

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:padding="16dp"
        android:layout_marginBottom="20dp" >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SDA"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Structural Dynamic Analyzer"
            android:textColor="#BBDEFB"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Análisis de integridad por vibración"
            android:textColor="#90CAF9"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Estado de calibración -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="16dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALIBRACIÓN (Línea Base)"
            android:textSize="11sp"
            android:textColor="#757575"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_calib_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin calibración"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/tv_base_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#424242"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Botón Calibrar -->
    <Button
        android:id="@+id/btn_calibrate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📐  Calibrar estructura (línea base)"
        android:textSize="15sp"
        android:background="#1565C0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Botón Diagnosticar -->
    <Button
        android:id="@+id/btn_diagnose"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔍  Diagnosticar estado actual"
        android:textSize="15sp"
        android:background="#B71C1C"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:enabled="false" />

    <!-- Espaciador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Limpiar calibración -->
    <Button
        android:id="@+id/btn_clear_calib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Borrar calibración"
        android:textSize="13sp"
        android:background="#EEEEEE"
        android:textColor="#757575"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Principio: IPN Análisis Dinámico por Vibración | FFT + Ventana Hanning"
        android:textSize="10sp"
        android:textColor="#BDBDBD"
        android:gravity="center"
        android:layout_marginTop="12dp" />

</LinearLayout>
